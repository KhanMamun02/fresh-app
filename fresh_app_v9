function previewWarning(){
  const proto=location.protocol;
  let bad=null;
  if(proto==='file:')bad='file';          // file: also reports a null origin
  else if(proto==='about:'||proto==='blob:'||proto==='data:')bad='preview';
  else{ try{ if(location.origin==='null')bad='preview' }catch(_){ bad='preview' } }
  if(bad==='preview')return `<div class="warn-box" style="margin-bottom:14px">
    <strong>This is a preview window, not a web page.</strong><br>
    Preview frames block downloads, so the recogniser cannot load here.
    Publish the file to GitHub Pages and open that link instead.<br>
    Everything else — logging, inventory, manual entry — works fine right here.
  </div>`;
  // file:// works on desktop Chrome, so say nothing unless it actually failed.
  if(bad==='file'&&Vision.state.status==='error')return `<div class="warn-box" style="margin-bottom:14px">
    <strong>Opened as a local file.</strong><br>
    That usually works, but if the download failed it is the likely cause.
    Run <code>python -m http.server</code> in this folder and open http://localhost:8000,
    or publish to GitHub Pages.
  </div>`;
  return '';
}

