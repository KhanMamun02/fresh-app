function renderPieChart(){
  const canvas=document.getElementById('pie-cv');
  if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const SIZE=130;canvas.width=SIZE;canvas.height=SIZE;
  const CX=SIZE/2,CY=SIZE/2,R=SIZE*0.46,IR=SIZE*0.26;
  ctx.clearRect(0,0,SIZE,SIZE);

  const groups={};
  S.entries.forEach(e=>{
    if(!CATS[e.cat])return;
    if(!groups[e.cat])groups[e.cat]={total:0,count:0};
    groups[e.cat].total+=fpct(e.time,e.days);
    groups[e.cat].count++;
  });
  const slices=Object.entries(groups).map(([cat,{total,count}])=>({
    cat,avg:total/count,count,col:CATS[cat].col
  })).filter(s=>s.count>0);

  if(slices.length===0){
    ctx.fillStyle='rgba(140,100,20,.12)';ctx.beginPath();ctx.arc(CX,CY,R,0,Math.PI*2);ctx.fill();
    ctx.beginPath();ctx.arc(CX,CY,IR,0,Math.PI*2);ctx.fillStyle='#FFFDF5';ctx.fill();
    return;
  }

  const totalCount=slices.reduce((s,sl)=>s+sl.count,0);
  let startAngle=-Math.PI/2;
  slices.forEach(sl=>{
    const sweep=(sl.count/totalCount)*Math.PI*2;
    const endAngle=startAngle+sweep;
    ctx.beginPath();ctx.moveTo(CX,CY);ctx.arc(CX,CY,R,startAngle,endAngle);ctx.closePath();
    ctx.fillStyle=sl.col;ctx.fill();
    ctx.beginPath();ctx.moveTo(CX,CY);ctx.arc(CX,CY,R*0.98,startAngle,endAngle);ctx.closePath();
    ctx.fillStyle=`rgba(0,0,0,${Math.max(0,0.5-sl.avg/250)})`;ctx.fill();
    ctx.beginPath();ctx.moveTo(CX,CY);ctx.arc(CX,CY,R+2,startAngle,startAngle+0.01);ctx.closePath();
    ctx.lineWidth=2;ctx.strokeStyle='#F5EDD6';ctx.stroke();
    startAngle=endAngle;
  });
  ctx.beginPath();ctx.arc(CX,CY,IR,0,Math.PI*2);ctx.fillStyle='#FFFDF5';ctx.fill();
}

function drawMiniPie(canvas,pct,col){
  const SIZE=28;canvas.width=SIZE;canvas.height=SIZE;
  const ctx=canvas.getContext('2d');
  const CX=SIZE/2,CY=SIZE/2,R=SIZE*0.44;
  ctx.beginPath();ctx.arc(CX,CY,R,0,Math.PI*2);ctx.fillStyle='rgba(140,100,20,.12)';ctx.fill();
  const sweep=(pct/100)*Math.PI*2;
  ctx.beginPath();ctx.moveTo(CX,CY);ctx.arc(CX,CY,R,-Math.PI/2,-Math.PI/2+sweep);ctx.closePath();
  ctx.fillStyle=col;ctx.fill();
  ctx.beginPath();ctx.arc(CX,CY,R*0.52,0,Math.PI*2);ctx.fillStyle='#FFFDF5';ctx.fill();
}
function renderMiniPies(){
  document.querySelectorAll('[data-pie-pct]').forEach(cv=>{
    drawMiniPie(cv,parseFloat(cv.getAttribute('data-pie-pct')),cv.getAttribute('data-pie-col')||'#4CAF72');
  });
}

