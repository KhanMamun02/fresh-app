async function importTraining(payload){
  const rows = (payload && payload.samples) || [];
  if (!rows.length) throw new Error('That file contains no training samples.');
  let added = 0, skipped = 0;
  for (const r of rows) {
    if (!Array.isArray(r.embedding) || !r.label) { skipped++; continue; }
    await tx('readwrite', s => s.add({
      label: String(r.label).trim().toLowerCase(),
      cat: r.category || r.cat || 'veg',
      embedding: r.embedding,
      thumb: r.photo || null,
      added: r.added || new Date().toISOString(),
    }));
    added++;
  }
  await refreshPrototypes();
  return { added, skipped };
}

function vocabSnippet(){
  if (!ctx || !ctx.textEmbeds || !ctx.textEmbeds.length)
    throw new Error('Load the recogniser first, then publish.');
  const packed = packEmbeds(ctx.textEmbeds);
  packed.hash = ctx.hash;
  packed.model = (window.CONFIG && window.CONFIG.model) || 'Xenova/clip-vit-base-patch32';
  return 'const BUILTIN_VOCAB = ' + JSON.stringify(packed) + ';';
}

function vocabIsBuiltIn(){
  try {
    if (typeof BUILTIN_VOCAB === 'undefined' || !BUILTIN_VOCAB) return false;
    const { prompts } = buildPrompts();
    return BUILTIN_VOCAB.hash === hashPrompts(prompts);
  } catch (_) { return false; }
}

/* The paste-over line for the repo. Prototypes only — 512 numbers per item,
   trimmed to 4 decimals, which is far smaller than shipping the photos and
   is all inference actually needs. */
function builtinSnippet(){
  const items = prototypes.map(p => ({
    label: p.label, cat: p.cat, n: p.n,
    vec: Array.from(p.vec, x => Math.round(x * 1e4) / 1e4),
  }));
  return 'const BUILTIN_TRAINING = ' +
    JSON.stringify({ version:1, model:'Xenova/clip-vit-base-patch32', items }) + ';';
}

async function onImportTraining(e){
  const f=e.target?.files?.[0];
  e.target.value='';
  if(!f)return;
  try{
    const payload=JSON.parse(await f.text());
    if(payload.format!=='fresh-training-export')throw new Error('That is not a Fresh training export.');
    const {added,skipped}=await Vision.importTraining(payload);
    await refreshTrained();
    toast(skipped?`Imported ${added}, skipped ${skipped}`:`✦ Imported ${added} photos`,skipped>0);
  }catch(err){
    toast('Import failed: '+(err.message||err),true);
  }
}

