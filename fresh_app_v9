async function onTrainPhotos(e){
  const files=[...(e.target?.files||[])];
  e.target.value='';
  if(!files.length)return;
  const label=S.train.label.trim().toLowerCase();
  const cat=S.train.cat;
  if(!label||!cat){toast('Name the item and pick a category first',true);return}

  S.train.busy=true;S.train.done=0;S.train.total=files.length;S.train.msg='';render();
  let failed=0;
  for(const f of files){
    try{
      const big=await shrink(f,384,0.9);      // what the model sees
      const small=await shrink(f,96,0.6);     // what you see in the list
      await Vision.addSample(big,label,cat,small);
    }catch(err){
      console.error('training photo failed:',err);failed++;
    }
    S.train.done++;render();
  }
  S.train.busy=false;
  await refreshTrained();
  const ok=files.length-failed;
  toast(failed
    ? `Learned ${ok} of ${files.length} photos`
    : `✦ Learned ${ok} photo${ok>1?'s':''} of ${cleanName(label)}`, failed>0);
}

