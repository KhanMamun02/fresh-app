    days:d.days||cat.days,
    notes:d.notes,
    photo:manual?null:S.thumb,
  });
  // Cap the history so thumbnails stay inside the localStorage quota.
  S.entries=S.entries.slice(0,80);
  if(!sv('fe2',S.entries)){
    S.entries=S.entries.map((e,i)=>i<20?e:{...e,photo:null});
    if(!sv('fe2',S.entries))toast('Saved for this session only — storage is full',true);
  }
  closeOv('cls-ov');closeOv('ent-ov');
  resetScan();
  toast('✦ '+d.food.trim()+' logged');
  gTab('dash');
}

