/* ─── Photo handling ─── */
function onDrop(e){
  e.preventDefault();
  document.getElementById('dz')?.classList.remove('drag');
  const f=e.dataTransfer?.files?.[0];
  if(f?.type.startsWith('image/'))acceptPhoto(f);
}
function onFile(e){
  const f=e.target?.files?.[0];
  if(f)acceptPhoto(f);
}

/* Downscale in the browser: a 12 MP phone photo becomes ~120 KB, which is the
   difference between a fast identification and a stalled one. */
function shrink(file,maxEdge,quality){
  return new Promise((resolve,reject)=>{
    const url=URL.createObjectURL(file);
    const img=new Image();
    img.onload=()=>{
      URL.revokeObjectURL(url);
      const scale=Math.min(1,maxEdge/Math.max(img.width,img.height));
      const cv=document.createElement('canvas');
      cv.width=Math.max(1,Math.round(img.width*scale));
      cv.height=Math.max(1,Math.round(img.height*scale));
      cv.getContext('2d').drawImage(img,0,0,cv.width,cv.height);
      resolve(cv.toDataURL('image/jpeg',quality));
    };
    img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('That file could not be opened as an image.'))};
    img.src=url;
  });
}

async function acceptPhoto(file){
  S.result=null;S.scanError=null;S.identifying=false;
  try{
    S.preview=await shrink(file,720,0.85);
    S.thumb  =await shrink(file,160,0.7);
  }catch(err){
    S.preview=null;S.thumb=null;S.scanError=err.message;render();return;
  }
  render();
  identify();
}

async function identify(){
  if(!S.preview)return;
  S.identifying=true;S.scanError=null;render();
  try{
    const result=CONFIG.apiBase
      ? await classifyViaApi(S.preview)
      : await Vision.classify(S.preview);
    if(!result.predictions.length)throw new Error('No food recognised in that photo.');
    S.result=result;S.identifying=false;render();
    openClassify();
  }catch(err){
    S.identifying=false;
    S.scanError=(err&&err.message)||'Could not identify that photo. Add the item by typing its name instead.';
    render();
  }
}

async function classifyViaApi(dataUrl){
  const blob=await (await fetch(dataUrl)).blob();
  const form=new FormData();
  form.append('image',blob,'food.jpg');
  const res=await fetch(CONFIG.apiBase.replace(/\/$/,'')+'/classify?top_k=4',{method:'POST',body:form});
  const body=await res.json();
  if(!res.ok)throw new Error(body.detail||'The classifier rejected that photo.');
  return {
    predictions:(body.predictions||[]).map(p=>({label:p.label,cat:p.category,confidence:p.confidence})),
    confidence:body.confidence,
  };
}

