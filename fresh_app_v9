<!-- ═══════════════════════════════════════════════════════
     VISION — CLIP zero-shot food recognition, in the browser
     Runs entirely client-side via transformers.js. No server,
     no photo ever leaves the device.
     ═══════════════════════════════════════════════════════ -->
<script type="module">
const CDN = 'https://cdn.jsdelivr.net/npm/@xenova/transformers@2.17.2';

const state = { status:'idle', progress:0, message:'' };
let loadPromise = null;
let ctx = null;   // { processor, vision_model, textEmbeds, labels }

let lastPaint = 0;
function setState(patch, force = false){
  const statusChanged = patch.status && patch.status !== state.status;
  Object.assign(state, patch);
  // The download callback fires hundreds of times; repainting on each one
  // would thrash the DOM for no visible benefit.
  const now = Date.now();
  if (!force && !statusChanged && now - lastPaint < 250) return;
  lastPaint = now;
  const tab = window.S && window.S.tab;
  if (tab === 'add' || tab === 'set') window.render();
}

function l2norm(v){
  let s = 0;
  for (let i = 0; i < v.length; i++) s += v[i] * v[i];
  const n = Math.sqrt(s) || 1;
  return v.map(x => x / n);
}

/* int8 + base64. A 512-float vector becomes 512 bytes instead of ~3.5 KB of
   JSON, and the loss is immaterial: cosine 0.99999 against the original, with
   identical top-5 ranking. */
function packEmbeds(embeds){
  const dim = embeds[0].length, n = embeds.length;
  const scales = new Array(n);
  const bytes = new Uint8Array(n * dim);
  for (let i = 0; i < n; i++) {
    const v = embeds[i];
    let m = 0;
    for (let j = 0; j < dim; j++) m = Math.max(m, Math.abs(v[j]));
    const s = (m / 127) || 1e-8;
    scales[i] = +s.toExponential(5);
    for (let j = 0; j < dim; j++)
      bytes[i * dim + j] = Math.max(0, Math.min(255, Math.round(v[j] / s) + 128));
  }
  let bin = ''; const CH = 0x8000;
  for (let i = 0; i < bytes.length; i += CH)
    bin += String.fromCharCode.apply(null, bytes.subarray(i, i + CH));
  return { dim, n, scales, data: btoa(bin) };
}

function unpackEmbeds(p){
  const bin = atob(p.data);
  const raw = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) raw[i] = bin.charCodeAt(i);
  const out = new Array(p.n);
  for (let i = 0; i < p.n; i++) {
    const s = p.scales[i], v = new Array(p.dim);
    for (let j = 0; j < p.dim; j++) v[j] = (raw[i * p.dim + j] - 128) * s;
    out[i] = l2norm(v);   // renormalising absorbs most of the quantisation error
  }
  return out;
}

function hashPrompts(list){
  // Cheap FNV-1a, only used to notice when the vocabulary changed.
  let h = 0x811c9dc5;
  const s = list.join('\u0000');
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return (h >>> 0).toString(16);
}

function buildPrompts(){
  const labels = window.VOCAB.map(([name, cat]) => ({ name, cat }));
  const prompts = labels.map(({ name, cat }) =>
    cat === 'reject' ? `a photo of ${name}` : `a close-up photo of ${name}, a food ingredient`);
  return { labels, prompts };
}

async function build(){
  // Only an opaque-origin frame is a hard stop. file:// is reported as an
  // advisory because Chrome does allow it, and blocking it would break a
  // setup that works.
  if (sandboxIssue() === 'preview') throw new Error(SANDBOX_MSG.preview);

  setState({ status:'loading', progress:0.02, message:'Starting the recogniser…' });

  let T;
  try {
    T = await import(CDN);
  } catch (e) {
    throw new Error('Could not reach the CDN. Check the connection, then retry.');
  }

  T.env.allowLocalModels = false;
  T.env.useBrowserCache = true;

  // Multi-threaded WASM needs SharedArrayBuffer, which needs COOP/COEP headers.
  // GitHub Pages does not send them, so threads must be off or the runtime
  // fails to start — this is the usual reason it dies on a phone.
  try {
    const wasm = T.env.backends?.onnx?.wasm;
    if (wasm) {
      wasm.numThreads = 1;
      if (typeof SharedArrayBuffer === 'undefined') wasm.proxy = false;
    }
  } catch (_) { /* older builds expose this differently; single-thread is the default there */ }

  const MODEL = (window.CONFIG && window.CONFIG.model) || 'Xenova/clip-vit-base-patch32';
  const opts = { quantized: true };
  let lastPct = -1;
  const track = (base, span) => p => {
    if (p && p.status === 'progress' && p.total) {
      const pct = p.loaded / p.total;
      if (Math.abs(pct - lastPct) < 0.02) return;
      lastPct = pct;
      setState({ progress: base + span * pct, message:'Downloading the recogniser…' });
    }
  };

  const { labels, prompts } = buildPrompts();
  const hash = hashPrompts(prompts);
  const key = 'textEmbeds:' + MODEL + ':' + hash;

  // Three places the vocabulary table can come from, cheapest first:
  //   1. baked into this file  — no download, no text model, works on any phone
  //   2. this device's cache   — computed here on a previous visit
  //   3. downloaded and computed — the expensive path, and the one that fails
  //                                on low-memory devices
  let embeds = null;

  const builtinVocab = (typeof BUILTIN_VOCAB !== 'undefined') ? BUILTIN_VOCAB : null;
  if (builtinVocab && builtinVocab.hash === hash && builtinVocab.n === prompts.length) {
    try {
      embeds = unpackEmbeds(builtinVocab);
      setState({ progress:0.45, message:'Using the built-in vocabulary…' });
    } catch (e) {
      console.warn('Built-in vocabulary could not be read; falling back.', e);
      embeds = null;
    }
  }

  if (!embeds) embeds = await metaGet(key);

  if (embeds && embeds.length === prompts.length) {
    setState({ progress:0.45, message:'Vocabulary ready…' });
  } else {
    setState({ progress:0.05, message:'Downloading the language half…' });
    const tokenizer  = await T.AutoTokenizer.from_pretrained(MODEL, { ...opts, progress_callback: track(0.05, 0.15) });
    const text_model = await T.CLIPTextModelWithProjection.from_pretrained(MODEL, { ...opts, progress_callback: track(0.20, 0.20) });

    setState({ progress:0.40, message:'Reading the food vocabulary…' });
    embeds = [];
    const BATCH = 16;   // small batches keep peak memory low on mobile
    for (let i = 0; i < prompts.length; i += BATCH) {
      const inputs = tokenizer(prompts.slice(i, i + BATCH), { padding: true, truncation: true });
      const { text_embeds } = await text_model(inputs);
      for (const row of text_embeds.tolist()) embeds.push(l2norm(row));
      setState({ progress: 0.40 + 0.20 * ((i + BATCH) / prompts.length) });
      await new Promise(r => setTimeout(r, 0));   // let the UI breathe
    }

    // Release it before loading the vision half — both at once is what tips
    // a phone over its memory limit.
    try { await text_model.dispose?.(); } catch (_) {}

    await metaSet(key, embeds);
  }

  setState({ progress:0.65, message:'Downloading the image half…' });
  const processor    = await T.AutoProcessor.from_pretrained(MODEL, { ...opts, progress_callback: track(0.65, 0.10) });
  const vision_model = await T.CLIPVisionModelWithProjection.from_pretrained(MODEL, { ...opts, progress_callback: track(0.75, 0.24) });

  ctx = { processor, vision_model, textEmbeds: embeds, labels, hash };
  setState({ status:'ready', progress:1, message:'Ready' }, true);
}

/* A page served from about:srcdoc, blob: or data: has an opaque origin and no
   outbound network. That is a preview pane, not a website, and no amount of
   retrying will help — so say so plainly instead of reporting a network error. */
function sandboxIssue(){
  const proto = location.protocol;
  if (proto === 'file:') return 'file';   // also has a null origin, so check it first
  if (proto === 'about:' || proto === 'blob:' || proto === 'data:') return 'preview';
  try { if (location.origin === 'null') return 'preview'; } catch (_) { return 'preview'; }
  return null;
}

const SANDBOX_MSG = {
  preview: 'This page is running inside a preview frame, which blocks downloads. '
         + 'It needs a real web address — publish to GitHub Pages and open that link, '
         + 'or serve the folder locally and open the localhost address.',
  file: 'The download was blocked, and this page was opened as a local file, '
      + 'which is the likely cause. Serve the folder instead — run '
      + '"python -m http.server" in it and open http://localhost:8000 — '
      + 'or publish to GitHub Pages and open that link.',
};

function explain(err){
  if (sandboxIssue() === 'preview') return SANDBOX_MSG.preview;
  const raw = (err && (err.message || String(err))) || 'unknown error';
  const low = raw.toLowerCase();
  // Opening the file directly usually works, but if the download is what broke,
  // it is worth naming as a cause.
  if (sandboxIssue() === 'file' && (low.includes('fetch') || low.includes('network')))
    return SANDBOX_MSG.file;
  if (low.includes('sharedarraybuffer') || low.includes('worker') || low.includes('thread'))
    return 'This browser blocked multi-threaded WebAssembly. Reload the page — the app now asks for single-threaded mode.';
  if (low.includes('memory') || low.includes('allocat') || low.includes('out of'))
    return 'The phone ran out of memory. Close other tabs and apps, then retry — the first load is the heaviest.';
  if (low.includes('quota') || low.includes('storage'))
    return 'No room to cache the recogniser. Free up storage, or turn off Private Browsing, then retry.';
  if (low.includes('fetch') || low.includes('network') || low.includes('cdn') || low.includes('load failed'))
    return 'Could not download the recogniser. Check the connection — it needs about 50 MB on first use.';
  if (low.includes('timed out'))
    return raw;
  return raw;
}

async function load(force = false){
  if (state.status === 'ready') return;
  if (loadPromise && !force) return loadPromise;

  const TIMEOUT_MS = 240000;
  loadPromise = Promise.race([
    build(),
    new Promise((_, rej) => setTimeout(
      () => rej(new Error('Timed out after 4 minutes. On a slow connection, stay on this tab and retry.')),
      TIMEOUT_MS)),
  ]).catch(err => {
    console.error('Vision load failed:', err);
    loadPromise = null;
    lastError = err;
    setState({ status:'error', message: explain(err) });
    throw err;
  });
  return loadPromise;
}

let lastError = null;

async function diagnostics(){
  let quota = null;
  try {
    const est = await navigator.storage?.estimate?.();
    if (est) quota = Math.round((est.quota || 0) / 1048576) + ' MB quota, '
                   + Math.round((est.usage || 0) / 1048576) + ' MB used';
  } catch (_) {}
  return {
    status: state.status,
    moduleLoaded: true,
    bootErrors: (window.__bootErrors || []).join(' | ') || 'none',
    error: lastError ? (lastError.message || String(lastError)) : null,
    runningIn: sandboxIssue() === 'preview' ? 'PREVIEW FRAME — needs a real URL'
             : sandboxIssue() === 'file'    ? 'opened as a local file — fine on desktop, '
                                            + 'but phones need a hosted link'
             : 'a hosted web page (correct)',
    url: location.href,
    secureContext: window.isSecureContext,
    protocol: location.protocol,
    sharedArrayBuffer: typeof SharedArrayBuffer !== 'undefined',
    webAssembly: typeof WebAssembly !== 'undefined',
    wasmSimd: (() => { try { return WebAssembly.validate(new Uint8Array(
      [0,97,115,109,1,0,0,0,1,5,1,96,0,1,123,3,2,1,0,10,10,1,8,0,65,0,253,15,253,98,11])); }
      catch (_) { return false; } })(),
    indexedDB: typeof indexedDB !== 'undefined',
    createImageBitmap: typeof createImageBitmap === 'function',
    storage: quota,
    cores: navigator.hardwareConcurrency || null,
    memoryGB: navigator.deviceMemory || null,
    online: navigator.onLine,
    userAgent: navigator.userAgent,
  };
}

/* ═══════════════════════════════════════════════════════
   TRAINING STORE — your photos, embedded and kept locally
   ═══════════════════════════════════════════════════════
   Each training photo is run through CLIP's image encoder once and stored as
   a 512-number embedding in IndexedDB. Averaging a class's embeddings gives a
   "prototype" — what that food looks like to the model. Matching a new photo
   against those prototypes is few-shot learning: no gradients, no GPU, and it
   takes effect the moment you add a photo.
*/
const DB_NAME = 'fresh-vision', DB_STORE = 'samples', META_STORE = 'meta';
let dbPromise = null;

function db(){
  if (dbPromise) return dbPromise;
  dbPromise = new Promise((resolve, reject) => {
    const req = indexedDB.open(DB_NAME, 2);
    req.onupgradeneeded = () => {
      const d = req.result;
      if (!d.objectStoreNames.contains(DB_STORE)) {
        const store = d.createObjectStore(DB_STORE, { keyPath:'id', autoIncrement:true });
        store.createIndex('label', 'label', { unique:false });
      }
      if (!d.objectStoreNames.contains(META_STORE)) {
        d.createObjectStore(META_STORE, { keyPath:'key' });
      }
    };
    req.onsuccess = () => resolve(req.result);
    req.onerror = () => reject(req.error || new Error('Could not open local storage.'));
  });
  return dbPromise;
}

function metaGet(key){
  return db().then(d => new Promise((resolve, reject) => {
    const r = d.transaction(META_STORE, 'readonly').objectStore(META_STORE).get(key);
    r.onsuccess = () => resolve(r.result ? r.result.value : null);
    r.onerror = () => reject(r.error);
  })).catch(() => null);
}
function metaSet(key, value){
  return db().then(d => new Promise((resolve, reject) => {
    const t2 = d.transaction(META_STORE, 'readwrite');
    t2.objectStore(META_STORE).put({ key, value });
    t2.oncomplete = () => resolve(true);
    t2.onerror = () => reject(t2.error);
  })).catch(() => false);
}

function tx(mode, fn){
  return db().then(d => new Promise((resolve, reject) => {
    const t = d.transaction(DB_STORE, mode);
    const store = t.objectStore(DB_STORE);
    let out;
    try { out = fn(store); } catch (e) { reject(e); return; }
    t.oncomplete = () => resolve(out && out.result !== undefined ? out.result : out);
    t.onerror = () => reject(t.error);
  }));
}

let prototypes = [];   // [{ label, cat, vec, n }]

function rebuildPrototypes(samples){
  const byLabel = new Map();
  for (const s of samples) {
    if (!byLabel.has(s.label)) byLabel.set(s.label, { label:s.label, cat:s.cat, vecs:[] });
    byLabel.get(s.label).vecs.push(s.embedding);
  }

  const out = new Map();
  for (const { label, cat, vecs } of byLabel.values()) {
    const dim = vecs[0].length;
    const mean = new Array(dim).fill(0);
    for (const v of vecs) for (let i = 0; i < dim; i++) mean[i] += v[i];
    for (let i = 0; i < dim; i++) mean[i] /= vecs.length;
    out.set(label, { label, cat, vec: l2norm(mean), n: vecs.length, source:'device' });
  }

  // Fold in whatever was committed to the file. Where both exist, average them
  // by photo count so neither side is silently thrown away.
  const builtin = (typeof BUILTIN_TRAINING !== 'undefined' && BUILTIN_TRAINING.items) || [];
  for (const b of builtin) {
    if (!Array.isArray(b.vec) || !b.vec.length) continue;
    const bn = b.n || 1;
    const existing = out.get(b.label);
    if (!existing) {
      out.set(b.label, { label:b.label, cat:b.cat, vec:l2norm(b.vec), n:bn, source:'builtin' });
    } else {
      const dim = existing.vec.length;
      const merged = new Array(dim);
      for (let i = 0; i < dim; i++) {
        merged[i] = (existing.vec[i] * existing.n + b.vec[i] * bn) / (existing.n + bn);
      }
      out.set(b.label, { label:b.label, cat:existing.cat || b.cat, vec:l2norm(merged),
                         n: existing.n + bn, source:'both' });
    }
  }

  prototypes = [...out.values()];
  return prototypes;
}

async function refreshPrototypes(){
  const samples = await tx('readonly', s => s.getAll());
  rebuildPrototypes(samples || []);
  return prototypes;
}

async function embedImage(dataUrl){
  if (state.status !== 'ready') await load();
  const T = await import(CDN);
  const blob = await (await fetch(dataUrl)).blob();
  const image = typeof T.RawImage.fromBlob === 'function'
    ? await T.RawImage.fromBlob(blob)
    : await T.RawImage.read(dataUrl);
  const inputs = await ctx.processor(image);
  const { image_embeds } = await ctx.vision_model(inputs);
  return l2norm(image_embeds.tolist()[0]);
}

async function addSample(dataUrl, label, cat, thumb){
  const embedding = await embedImage(dataUrl);
  await tx('readwrite', s => s.add({
    label: label.trim().toLowerCase(), cat, embedding, thumb: thumb || null,
    added: new Date().toISOString(),
  }));
  await refreshPrototypes();
  return embedding.length;
}

async function listTrained(){
  const samples = await tx('readonly', s => s.getAll()) || [];
  const byLabel = new Map();
  for (const s of samples) {
    if (!byLabel.has(s.label)) byLabel.set(s.label,
      { label:s.label, cat:s.cat, count:0, thumbs:[], onDevice:0, builtIn:0 });
    const e = byLabel.get(s.label);
    e.count++; e.onDevice++;
    if (e.thumbs.length < 5 && s.thumb) e.thumbs.push(s.thumb);
  }
  const builtin = (typeof BUILTIN_TRAINING !== 'undefined' && BUILTIN_TRAINING.items) || [];
  for (const b of builtin) {
    if (!byLabel.has(b.label)) byLabel.set(b.label,
      { label:b.label, cat:b.cat, count:0, thumbs:[], onDevice:0, builtIn:0 });
    const e = byLabel.get(b.label);
    e.builtIn += (b.n || 1);
    e.count += (b.n || 1);
    e.cat = e.cat || b.cat;
  }
  return [...byLabel.values()].sort((a,b) => a.label.localeCompare(b.label));
}

async function deleteLabel(label){
  const samples = await tx('readonly', s => s.getAll()) || [];
  const ids = samples.filter(s => s.label === label).map(s => s.id);
  await tx('readwrite', s => { ids.forEach(id => s.delete(id)); });
  await refreshPrototypes();
}

async function clearTraining(){
  await tx('readwrite', s => s.clear());
  await refreshPrototypes();
}

async function importTraining(payload){
  const rows = (payload && payload.samples) || [];
  if (!rows.length) throw new Error('That file contains no training samples.');
  let added = 0, skipped = 0;
  for (const r of rows) {
    if (!Array.isArray(r.embedding) || !r.label) { skipped++; continue; }
    await tx('readwrite', s => s.add({
      label: String(r.label).trim().toLowerCase(),
      cat: r.category || r.cat || 'veg',
      embedding: r.embedding,
      thumb: r.photo || null,
      added: r.added || new Date().toISOString(),
    }));
    added++;
  }
  await refreshPrototypes();
  return { added, skipped };
}

function vocabSnippet(){
  if (!ctx || !ctx.textEmbeds || !ctx.textEmbeds.length)
    throw new Error('Load the recogniser first, then publish.');
  const packed = packEmbeds(ctx.textEmbeds);
  packed.hash = ctx.hash;
  packed.model = (window.CONFIG && window.CONFIG.model) || 'Xenova/clip-vit-base-patch32';
  return 'const BUILTIN_VOCAB = ' + JSON.stringify(packed) + ';';
}

function vocabIsBuiltIn(){
  try {
    if (typeof BUILTIN_VOCAB === 'undefined' || !BUILTIN_VOCAB) return false;
    const { prompts } = buildPrompts();
    return BUILTIN_VOCAB.hash === hashPrompts(prompts);
  } catch (_) { return false; }
}

/* The paste-over line for the repo. Prototypes only — 512 numbers per item,
   trimmed to 4 decimals, which is far smaller than shipping the photos and
   is all inference actually needs. */
function builtinSnippet(){
  const items = prototypes.map(p => ({
    label: p.label, cat: p.cat, n: p.n,
    vec: Array.from(p.vec, x => Math.round(x * 1e4) / 1e4),
  }));
  return 'const BUILTIN_TRAINING = ' +
    JSON.stringify({ version:1, model:'Xenova/clip-vit-base-patch32', items }) + ';';
}

async function exportTraining(){
  const samples = await tx('readonly', s => s.getAll()) || [];
  return {
    format:'fresh-training-export', version:1,
    model:'Xenova/clip-vit-base-patch32', dim: samples[0]?.embedding.length || 0,
    exported_at:new Date().toISOString(),
    samples: samples.map(s => ({ label:s.label, category:s.cat, added:s.added,
                                 embedding:s.embedding, photo:s.thumb })),
  };
}

async function classify(dataUrl, topK = 4){
  if (state.status !== 'ready') await load();
  if (!ctx) throw new Error('The recogniser is not ready yet.');

  const img = await embedImage(dataUrl);
  const dot = (a, b) => { let d = 0; for (let i = 0; i < a.length; i++) d += a[i] * b[i]; return d; };

  // Text similarity: what the model already knows from its own pretraining.
  const sims = new Map();
  ctx.labels.forEach((l, i) => sims.set(l.name, { cat:l.cat, text:dot(ctx.textEmbeds[i], img), proto:null, n:0 }));

  // Prototype similarity: what your own photos have taught it.
  for (const p of prototypes) {
    const entry = sims.get(p.label) || { cat:p.cat, text:null, proto:null, n:0 };
    entry.proto = dot(p.vec, img);
    entry.n = p.n;
    entry.cat = entry.cat || p.cat;
    sims.set(p.label, entry);
  }

  // Blend. One photo nudges the score; twenty photos dominate it. K sets how
  // fast your own data overtakes the text prior.
  const K = 5;
  const scale = 100;
  const names = [...sims.keys()];
  const logits = names.map(name => {
    const e = sims.get(name);
    if (e.proto === null) return e.text * scale;
    if (e.text === null)  return e.proto * scale;
    const w = e.n / (e.n + K);
    return ((1 - w) * e.text + w * e.proto) * scale;
  });

  const max = Math.max(...logits);
  const exps = logits.map(x => Math.exp(x - max));
  const sum  = exps.reduce((a, b) => a + b, 0);
  const probs = exps.map(x => x / sum);

  const ranked = probs
    .map((p, i) => ({ label: names[i], cat: sims.get(names[i]).cat,
                      confidence: p, taught: sims.get(names[i]).n }))
    .sort((a, b) => b.confidence - a.confidence);

  // Keep one 'reject' entry if it wins, so the app can say "that isn't food",
  // but never clutter the alternatives with the rest of them.
  const top = ranked[0];
  const foods = ranked.filter(r => r.cat !== 'reject').slice(0, topK);
  const predictions = top.cat === 'reject' ? [top, ...foods].slice(0, topK) : foods;

  return { predictions, confidence: predictions[0].confidence };
}

window.Vision = { __real:true, sandboxIssue,
                  state, load, classify, embedImage, addSample, listTrained,
                  deleteLabel, clearTraining, exportTraining, importTraining,
                  builtinSnippet, vocabSnippet, vocabIsBuiltIn,
                  refreshPrototypes, diagnostics,
                  get prototypes(){ return prototypes; } };
rebuildPrototypes([]);
refreshPrototypes().catch(() => { rebuildPrototypes([]); });
if (window.S && window.S.tab === 'add') load();
</script>

